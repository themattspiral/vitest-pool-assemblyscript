{
  "name": "vitest-pool-assemblyscript",
  "version": "0.0.0-semantically-released",
  "description": "AssemblyScript testing with Vitest - Simple, fast, familiar, AS-native, with full coverage output",
  "author": "Matt Ritter <matthew.d.ritter@gmail.com>",
  "license": "MIT",
  "keywords": [
    "assemblyscript",
    "vitest",
    "unit test",
    "unit testing",
    "webassembly",
    "wasm",
    "testing",
    "testing framework",
    "test runner",
    "compile-to-wasm",
    "custom pool",
    "vitest plugin"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config/index.d.mts",
      "default": "./dist/config/index.mjs"
    },
    "./v3": {
      "types": "./dist/index-v3.d.mts",
      "default": "./dist/index-v3.mjs"
    },
    "./v3/config": {
      "types": "./dist/config/index-v3.d.mts",
      "default": "./dist/config/index-v3.mjs"
    },
    "./coverage": {
      "types": "./dist/coverage-provider/index.d.mts",
      "default": "./dist/coverage-provider/index.mjs"
    },
    "./assembly": {
      "types": "./assembly/index.mts",
      "default": "./assembly/index.mts"
    },
    "./__internal": {
      "types": "./dist/internal-test-entry.d.mts",
      "default": "./dist/internal-test-entry.mjs"
    }
  },
  "files": [
    "dist",
    "prebuilds",
    "binding.gyp",
    "src/instrumentation/native/addon.cpp",
    "scripts/setup-binaryen.js",
    "scripts/install.js",
    "BINARYEN_VERSION",
    "assembly"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themattspiral/vitest-pool-assemblyscript.git"
  },
  "bugs": {
    "url": "https://github.com/themattspiral/vitest-pool-assemblyscript/issues"
  },
  "homepage": "https://github.com/themattspiral/vitest-pool-assemblyscript#readme",
  "scripts": {
    "build": "tsdown",
    "//------------ Testing ------------": "",
    "tc": "tsc --noEmit",
    "test": "vitest run",
    "ctest": "npm run build && vitest run",
    "tctest": "npm run tc && npm run build && vitest run",
    "test:watch": "vitest",
    "test:ext:setup": "node scripts/setup-test-external.js",
    "test:ext:run": "node scripts/run-test-external.js",
    "test:ext:pass": "node scripts/setup-test-external.js && node scripts/run-test-external.js -c vitest.pass.config.ts",
    "test:ext:err": "node scripts/setup-test-external.js && node scripts/run-test-external.js -c vitest.errors.config.ts",
    "test:ext:all": "node scripts/setup-test-external.js && node scripts/run-test-external.js",
    "etestp": "npm run test:ext:pass",
    "eteste": "npm run test:ext:err",
    "etest": "npm run test:ext:all",
    "//------------ Native Addon ------------": "",
    "setup-binaryen": "node scripts/setup-binaryen.js",
    "build:native": "node-gyp rebuild",
    "build:prebuild": "prebuildify --napi --strip --tag-libc",
    "install": "node scripts/install.js"
  },
  "dependencies": {
    "birpc": "^4.0.0",
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4",
    "source-map": "~0.7.6",
    "tinyglobby": "~0.2.15",
    "tinypool": "^2.1.0",
    "tinyrainbow": "^3.0.3"
  },
  "peerDependencies": {
    "@vitest/coverage-v8": "^3.2.0 || ^4.0.0",
    "@vitest/runner": "^3.2.0 || ^4.0.0",
    "@vitest/utils": "^3.2.0 || ^4.0.0",
    "assemblyscript": "^0.28.9",
    "istanbul-lib-coverage": "^3.2.2",
    "vitest": "^3.2.0 || ^4.0.0"
  },
  "devDependencies": {
    "@semantic-release/github": "^12.0.3",
    "@semantic-release/npm": "^13.1.3",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/node": "22.19.1",
    "@types/source-map": "~0.5.2",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/runner": "^4.0.18",
    "@vitest/utils": "^4.0.18",
    "assemblyscript": "~0.28.9",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "istanbul-lib-coverage": "^3.2.2",
    "node-gyp": "^12.2.0",
    "prebuildify": "^6.0.1",
    "semantic-release": "^25.0.3",
    "tsdown": "^0.20.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
