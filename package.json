{
  "name": "vitest-pool-assemblyscript",
  "version": "0.0.1",
  "description": "AssemblyScript testing with Vitest - Simple, fast, familiar, AS-native, with full coverage output",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./coverage": {
      "types": "./dist/coverage-provider/index.d.ts",
      "default": "./dist/coverage-provider/index.js"
    },
    "./assembly": {
      "types": "./assembly/index.ts",
      "default": "./assembly/index.ts"
    }
  },
  "files": [
    "dist",
    "assembly"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themattspiral/vitest-pool-assemblyscript.git"
  },
  "bugs": {
    "url": "https://github.com/themattspiral/vitest-pool-assemblyscript/issues"
  },
  "homepage": "https://github.com/themattspiral/vitest-pool-assemblyscript#readme",
  "scripts": {
    "build": "tsup",
    "tc": "tsc --noEmit",
    "dev": "tsup --watch",
    "//------------ Testing ------------": "",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fixtures": "vitest run -c test-fixtures/vitest.config.ts",
    "//------------ Native Addon ------------": "",
    "setup-binaryen": "node scripts/setup-binaryen.js",
    "build:native": "node-gyp rebuild"
  },
  "dependencies": {
    "birpc": "^2.4.0",
    "node-addon-api": "^8.5.0",
    "source-map": "^0.7.6",
    "test-exclude": "^7.0.1",
    "tinypool": "^2.0.0"
  },
  "peerDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/runner": "^3.2.4",
    "assemblyscript": "^0.28.9",
    "binaryen": "^124.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/node": "^24.8.1",
    "@types/source-map": "^0.5.2",
    "@types/test-exclude": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/runner": "^3.2.4",
    "assemblyscript": "^0.28.9",
    "binaryen": "^124.0.0",
    "birpc": "^2.4.0",
    "istanbul-lib-coverage": "^3.2.2",
    "node-gyp": "^12.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
