{
  "extends": "assemblyscript/std/assembly.json",
  "include": [
    "./**/*.ts"
  ],
  "compilerOptions": {
    "rootDir": "../..",

    // Resolve package imports in IDE
    //  - local project is not checked through node_modules resolution in AS like it would be with JS
    //  - applies to IDE only - For actual AS code, this is handled by the AS compiler
    //    (see readFile() implementation given to ascMain in compiler module)
    "paths": {
      "vitest-pool-assemblyscript/assembly": ["../../assembly/index.ts"],

      // the 'paths' block clobbers assemblyscript/std/assembly.json's own paths to the stdlib
      // - this only impacts direct stdlib imports, e.g. import { BLOCK_MAXSIZE } from "rt/common"
      "*": ["../../node_modules/assemblyscript/std/assembly/*"]
    }
  }
}
